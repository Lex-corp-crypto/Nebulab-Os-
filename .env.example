# =============== SECRETS & JWT ===============
SECRET_KEY=ChangeMeToARandom32ByteString!   # utilisé pour signer les JWT
# Vous pouvez générer une clé avec : openssl rand -hex 32

# =============== BASE DE DONNÉES ===============
DATABASE_URL=postgresql://postgres:postgres@db:5432/distributed_lab
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>

# =============== TUNNEL D'ACCÈS DISTANT (ZERO-CONFIG / NGROK) ===============
# Aucun compte ni token requis par défaut !
# Choix du provider : 'auto' (défaut, zéro config), 'localhost.run', 'pinggy', 'serveo', 'ngrok', 'disabled'
TUNNEL_PROVIDER=auto
TUNNEL_ENABLED=true
# Optionnel : si vous souhaitez utiliser un compte ngrok perso, renseignez votre authtoken ici (sinon laissez vide)
NGROK_AUTHTOKEN=

# =============== REDIS (optionnel mais recommandé pour le job queue) ===============
REDIS_HOST=redis
REDIS_PORT=6379
# Si vous ne voulez pas utiliser Redis, laissez les valeurs – le job manager tombera
# automatiquement sur une implémentation basée sur PostgreSQL.

# =============== ALERTING THRESHOLDS (en pourcentage) ===============
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=95
MEMORY_WARNING_THRESHOLD=80
MEMORY_CRITICAL_THRESHOLD=95
DISK_WARNING_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=95

# =============== NOTIFICATIONS EMAIL (optionnel) ===============
EMAIL_ALERTS_ENABLED=false   # mettre à true pour activer
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre.email@gmail.com
SMTP_PASSWORD=VotreMotDePasseAppOuToken
ALERT_EMAIL_FROM=alerts@distributedlab.local
ALERT_EMAIL_TO=admin@votredomaine.com   # séparer plusieurs adresses par une virgule

# =============== NOTIFICATIONS WEBHOOK (optionnel) ===============
WEBHOOK_ALERTS_ENABLED=false   # mettre à true pour activer
WEBHOOK_URL=https://example.com/webhook/distributed-lab-alert
WEBHOOK_HEADERS={"Content-Type":"application/json"}   # JSON valide

# =============== HEALTH‑CHECKER ===============
HEALTH_CHECK_INTERVAL=30   # secondes entre deux checks complets
HEALTH_CHECK_TIMEOUT=10    # timeout pour chaque sous‑check (en secondes)

# =============== DIVERS ===============
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR
TZ=Europe/Paris            # fuseau horaire pour les logs interne